# CivicLens Environment Configuration Example
# Copy this file to .env.local and populate with your project credentials

# ----------------------------------------------------
# 1. Supabase Backend Integration (PostgreSQL + Auth + Storage)
# ----------------------------------------------------
# Create a free project at https://supabase.com
# Find these values in Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ----------------------------------------------------
# 2. AI Multi-modal Vision API (Google Gemini)
# ----------------------------------------------------
# Get a free API key at https://aistudio.google.com
# If omitted, CivicLens seamlessly falls back to its local smart classifier
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------
# 3. Optional Map & Application Settings
# ----------------------------------------------------
VITE_APP_NAME=CivicLens
VITE_DEFAULT_LAT=37.7749
VITE_DEFAULT_LNG=-122.4194
