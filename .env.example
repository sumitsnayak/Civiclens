# CivicLens Environment Configuration Example
# Copy this file to .env.local and populate with your project credentials

# ----------------------------------------------------
# 1. Supabase Backend Integration (PostgreSQL + Auth + Storage)
# ----------------------------------------------------
# Create a free project at https://supabase.com
# Find these values in Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ----------------------------------------------------
# 2. BharatCode Model API (BharatCode Build League Hackathon)
# ----------------------------------------------------
# Obtain your API key from the BharatCode portal: https://bharatcode.ai/build
# IMPORTANT: BHARATCODE_API_KEY is stored securely on the server and is NEVER
# exposed in client browser bundles or committed to GitHub.
BHARATCODE_API_KEY=your_bharatcode_api_key_here
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1

# ----------------------------------------------------
# 3. Optional Map & Application Settings
# ----------------------------------------------------
VITE_APP_NAME=CivicLens
VITE_DEFAULT_LAT=37.7749
VITE_DEFAULT_LNG=-122.4194
